{
  "version": "2.1",
  "name": "ai-tool-square",
  "description": "CodingHub - 全栈 Web 应用 (工具广场 + 论坛 + 视频)",

  "runtime": {
    "java": "17",
    "node": "18+",
    "database": "mysql:8.x",
    "gradle": "8.x (wrapper included)",
    "framework": "Spring Boot 3.2.5"
  },

  "services": {
    "mysql": {
      "host": "localhost",
      "port": 3306,
      "database": "ai_tool_square",
      "user": "root",
      "password": "${MYSQL_PASSWORD}",
      "startup_check": "mysqladmin ping -h localhost -u root -p${MYSQL_PASSWORD}",
      "init_commands": [
        "CREATE DATABASE IF NOT EXISTS ai_tool_square CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
      ]
    }
  },

  "env_vars": {
    "required": [
      "MYSQL_PASSWORD=root"
    ],
    "optional": [
      "AIHUB_FILE_BASE_DIR=/Users/kirito/aifiles  # 文件存储根目录，默认 ~/.aifiles",
      "VITE_API_BASE_URL=http://localhost:8082     # 前端 API 基础地址",
      "VITE_BACKEND_PORT=8082                      # 前端 MCP 代理端口",
      "BACKEND_PORT=8082                           # Vite 开发代理目标端口",
      "JAVA_HOME=/path/to/jdk-17                   # JDK 17 路径"
    ]
  },

  "startup": {
    "backend": {
      "command": "cd backend && ./gradlew bootRun",
      "port": 8082,
      "ready_check": "curl -f http://localhost:8082/actuator/health || echo 'checking'",
      "depends_on": ["mysql"]
    },
    "frontend": {
      "command": "cd frontend && npm run dev",
      "port": 5173,
      "ready_check": "curl -f http://localhost:5173",
      "depends_on": ["backend"]
    }
  },

  "ports": {
    "backend": 8082,
    "frontend": 5173,
    "mysql": 3306
  },

  "secrets": [
    "MYSQL_PASSWORD",
    "JWT_SECRET"
  ],

  "jwt": {
    "library": "jjwt 0.12.5",
    "secret_env": "JWT_SECRET",
    "header": "Authorization",
    "prefix": "Bearer",
    "password_encoding": "BCrypt"
  },

  "file_upload": {
    "base_dir_env": "AIHUB_FILE_BASE_DIR",
    "base_dir_default": "~/.aifiles",
    "api_endpoint": "/api/files/upload",
    "max_file_size": "10MB"
  },

  "database_schema": {
    "tables": {
      "core": [
        "user",
        "category",
        "tool",
        "tool_file",
        "tool_like",
        "tool_comment"
      ],
      "tag": [
        "tag",
        "tool_tag",
        "video_tag"
      ],
      "forum": [
        "forum_category",
        "forum_tag",
        "forum_post",
        "forum_post_tag",
        "forum_comment",
        "forum_like",
        "post_favorite"
      ],
      "video": [
        "video",
        "video_comment",
        "video_like",
        "video_favorite",
        "danmaku"
      ],
      "knowledge_base": [
        "knowledge_base",
        "kb_document"
      ],
      "notification": [
        "notification"
      ],
      "feedback": [
        "feedback_message"
      ]
    },
    "migrations": {
      "path": "backend/src/main/resources/db/migration/",
      "files": ["V1", "V2", "V3_add_sort_and_pin", "V3_add_user_nickname", "V4", "V5", "V6", "V7", "V8", "V9"],
      "tool": "Flyway (spring.flyway.enabled=true)"
    },
    "init_sql_path": "Makefile (make db 命令)"
  },

  "notes": [
    "后端使用 Spring Boot 3.2.5 + Spring Security + JPA + Flyway (9 migrations)",
    "前端使用 Vue 3 + TypeScript + Vite + Pinia",
    "认证使用 JWT (jjwt 0.12.5)",
    "密码使用 BCrypt 加密存储",
    "文件上传存储在 AIHUB_FILE_BASE_DIR 指定的本地目录",
    "所有用户输入通过 XssSanitizer.sanitize() 过滤",
    "MCP: 17 tools via SSE (核心CRUD + 知识库 + 标签)",
    "Flyway 迁移文件: backend/src/main/resources/db/migration/ (V1~V9)",
    "新增模块: feedback, kb(知识库), notification(通知), tag(统一标签)"
  ]
}
