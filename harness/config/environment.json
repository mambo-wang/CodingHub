{
  "version": "2.0",
  "name": "ai-tool-square",
  "description": "CodingHub - 全栈 Web 应用",

  "runtime": {
    "java": "17",
    "node": "18+",
    "database": "mysql:8.x"
  },

  "services": {
    "mysql": {
      "host": "localhost",
      "port": 3306,
      "database": "ai_tool_square",
      "user": "root",
      "password": "${MYSQL_PASSWORD}",
      "startup_check": "mysqladmin ping -h localhost -u root -p${MYSQL_PASSWORD}",
      "init_commands": [
        "CREATE DATABASE IF NOT EXISTS ai_tool_square CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
      ]
    }
  },

  "env_vars": {
    "required": [
      "MYSQL_PASSWORD=root"
    ],
    "optional": [
      "AIHUB_FILE_BASE_DIR=/Users/kirito/aifiles  # 文件存储根目录，默认 ~/.aifiles"
    ]
  },

  "startup": {
    "backend": {
      "command": "cd backend && ./gradlew bootRun",
      "port": 8081,
      "ready_check": "curl -f http://localhost:8081/actuator/health || echo 'checking'",
      "depends_on": ["mysql"]
    },
    "frontend": {
      "command": "cd frontend && npm run dev",
      "port": 5173,
      "ready_check": "curl -f http://localhost:5173",
      "depends_on": ["backend"]
    }
  },

  "ports": {
    "backend": 8081,
    "frontend": 5173,
    "mysql": 3306
  },

  "secrets": [
    "MYSQL_PASSWORD"
  ],

  "database_schema": {
    "tables": ["user", "category", "tool", "tool_file"],
    "init_sql_path": "Makefile (make db 命令)"
  },

  "notes": [
    "后端使用 Spring Boot 3.2.5 + Spring Security + JPA",
    "前端使用 Vue 3 + TypeScript + Vite + Pinia",
    "认证使用 JWT (jjwt 0.12.5)",
    "密码使用 BCrypt 加密存储"
  ]
}